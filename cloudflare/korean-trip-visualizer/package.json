{
  "name": "cardbal-korean-trip-visualizer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "data:refresh": "python3 ../../scripts/generate_korean_transit_dataset.py",
    "data:site-only": "python3 scripts/build_dataset.py --output public/data/korean-trips.json",
    "deploy": "wrangler pages deploy dist --project-name cardbal-korean-trips --branch master"
  },
  "devDependencies": {
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
