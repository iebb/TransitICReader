<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#008F8C</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">#FAF8F5</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="AppTheme" parent="@style/BaseAppTheme">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_cardbal</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/splash_background</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>
