<resources>
    <color name="splash_background">#FAF3E8</color>

    <style name="BaseAppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#008F8C</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/splash_background</item>
        <item name="android:navigationBarColor">#FAF8F5</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="AppTheme" parent="@style/BaseAppTheme">
        <item name="android:windowBackground">@drawable/splash_screen</item>
    </style>
</resources>
